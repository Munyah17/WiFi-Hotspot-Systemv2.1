# Server
PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string

# Set to true to simulate the router and payment gateways (in-memory fakes) so
# the full app can be tested without a real MikroTik or payment credentials.
# Leave unset/false for real use.
MOCK_MODE=false

# This device's IP on the hotspot LAN (used to build the walled-garden portal URL)
LOCAL_APP_HOST=10.5.5.5

# MikroTik RouterOS API
ROUTER_HOST=10.5.5.1
ROUTER_API_PORT=8728
ROUTER_USER=admin
ROUTER_PASSWORD=

# Default super admin account, created on first run if no admin exists
ADMIN_PHONE=0770000000
ADMIN_PASSWORD=change-me

# Paynow (covers EcoCash / OneMoney mobile money payments)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Stripe (card payments — requires MikroTik walled-garden whitelist for Stripe domains)
STRIPE_SECRET_KEY=
